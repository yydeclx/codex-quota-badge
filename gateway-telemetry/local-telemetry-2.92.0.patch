+import { afterEach, beforeEach, describe, expect, spyOn, test } from "bun:test";
+import { pathToFileURL } from "node:url";
+import { estimateTokens } from "../../src/lib/token-estimate";
+import { repoPath, repoRoot } from "../helpers/repo-root";
+
+// Import with a deterministic startup gate; restore the caller's environment immediately.
+const originalGate = process.env.OPENCODEX_COMPANION_TELEMETRY;
+process.env.OPENCODEX_COMPANION_TELEMETRY = "1";
+const activity = await import("../../src/server/provider-activity");
+if (originalGate === undefined) delete process.env.OPENCODEX_COMPANION_TELEMETRY;
+else process.env.OPENCODEX_COMPANION_TELEMETRY = originalGate;
+const { beginProviderActivity: begin, observeProviderActivity: observe,
+  finishProviderActivity: finish, providerActivitySnapshot: snapshot } = activity;
+const { createSseInspector, trackSseForRequestLog } = await import("../../src/server/relay");
+type Context = Parameters<typeof begin>[0];
+type Transport = "http" | "ws";
+const epoch = 1_800_000_000_000;
+const maxAge = 30 * 60_000;
+let now = 0;
+let sequence = 0;
+let clock: ReturnType<typeof spyOn>;
+let contexts: Context[] = [];
+
+function context(overrides: Partial<Context> = {}): Context {
+  const value = { provider: "synthetic-provider", model: "gpt-test",
+    conversationId: "synthetic-session", ...overrides } as Context;
+  contexts.push(value);
+  return value;
+}
+function start(value = context(), transport: Transport = "http", signal?: AbortSignal) {
+  const id = `telemetry-test-${++sequence}`;
+  begin(value, id, epoch, signal, transport);
+  return { value, id };
+}
+function delta(value: Context, text: string, transport: Transport = "http", type = "response.output_text.delta") {
+  observe(value, { type, delta: text }, transport);
+}
+function row(id: string) {
+  return snapshot().requests.find(value => value.requestId === id)!;
+}
+
+beforeEach(() => {
+  clock = spyOn(performance, "now").mockImplementation(() => now);
+  now += maxAge + 10_001;
+  snapshot();
+});
+afterEach(() => {
+  for (const value of contexts) finish(value);
+  contexts = [];
+  now += maxAge + 10_001;
+  snapshot();
+  clock.mockRestore();
+});
+
+describe("provider activity timing and incremental estimates", () => {
+  test("waiting has no first output; first output freezes while last output advances", () => {
+    const { value, id } = start();
+    now += 70;
+    expect(row(id)).toMatchObject({ durationMs: 70, outputTokens: 0, estimated: true,
+      usageSource: "characters", lastOutputAt: null });
+    expect(row(id).firstOutputMs).toBeUndefined();
+    now += 30;
+    delta(value, "abcd");
+    expect(row(id)).toMatchObject({ firstOutputMs: 100, genStartMs: 100,
+      lastOutputMs: 100, lastOutputAt: epoch + 100, outputTokens: 1 });
+    now += 80;
+    delta(value, "中文");
+    expect(row(id)).toMatchObject({ firstOutputMs: 100, genStartMs: 100,
+      lastOutputMs: 180, durationMs: 180, outputTokens: estimateTokens("abcd中文", "gpt-test") });
+  });
+
+  for (const model of ["gpt-test", "kiro/claude-test", "claude-test", "qwen-test"]) {
+    test(`fragment totals match the canonical estimator for ${model}`, () => {
+      const { value, id } = start(context({ model }));
+      // Include every estimator script bucket, boundaries, and split surrogate pairs.
+      const text = "ab中韓한ᄀㄱ㐀あカ\u33ff\u4dc0\ud840\udc00🙂xy";
+      for (const unit of text.split("")) delta(value, unit);
+      expect(row(id).outputTokens).toBe(estimateTokens(text, model));
+      expect(row(id).outputTokens).toBeGreaterThan(0);
+    });
+  }
+
+  test("generation begins before visible output without inventing an early first token", () => {
+    const { value, id } = start();
+    now += 50; observe(value, { type: "response.output_item.added", item: { type: "reasoning" } });
+    expect(row(id).firstOutputMs).toBeUndefined();
+    expect(row(id).genStartMs).toBe(50);
+    now += 1000; delta(value, "abcd");
+    expect(row(id).genStartMs).toBe(50);
+    expect(row(id).firstOutputMs).toBe(1050);
+  });
+
+  test("each supported text, reasoning and tool delta contributes once", () => {
+    const { value, id } = start();
+    const types = ["response.output_text.delta", "response.reasoning_text.delta",
+      "response.reasoning_summary_text.delta", "response.function_call_arguments.delta",
+      "response.custom_tool_call_input.delta"];
+    for (const type of types) delta(value, "a中", "http", type);
+    expect(row(id).outputTokens).toBe(estimateTokens("a中".repeat(types.length), "gpt-test"));
+  });
+
+  test("empty/malformed deltas and non-output lifecycle, usage, audio and metadata do not count", () => {
+    const { value, id } = start();
+    const ignored: unknown[] = [null, undefined, 42, "text", {}, { delta: "body" },
+      { type: "response.output_text.delta", delta: "" },
+      { type: "response.output_text.delta", delta: { text: "body" } },
+      { type: "response.output_text.delta", delta: 1 }];
+    for (const type of ["response.created", "response.in_progress", "response.completed",
+      "response.failed", "response.output_item.added", "response.output_text.done",
+      "response.usage", "response.output_audio.delta", "ping"]) {
+      ignored.push({ type, delta: "must not count", response: { output: [{ text: "body" }] } });
+    }
+    for (const payload of ignored) observe(value, payload);
+    expect(row(id)).toMatchObject({ outputTokens: 0, lastOutputAt: null });
+    expect(row(id).firstOutputMs).toBeUndefined();
+  });
+});
+
+describe("provider activity isolation and terminal ownership", () => {
+  test("interleaved concurrent requests aggregate independently per provider", () => {
+    const a = start(context({ provider: "provider-a" }));
+    const b = start(context({ provider: "provider-b" }));
+    const c = start(context({ provider: "provider-a" }));
+    delta(a.value, "aaaa"); now += 25; delta(b.value, "中文");
+    expect(row(a.id).outputTokens).toBe(1);
+    expect(row(b.id).outputTokens).toBe(estimateTokens("中文"));
+    expect(row(c.id).outputTokens).toBe(0);
+    expect(snapshot().providers).toMatchObject({
+      "provider-a": { active: 2, lastOutputAt: epoch },
+      "provider-b": { active: 1, lastOutputAt: epoch + 25 },
+    });
+    finish(a.value);
+    expect(snapshot().providers["provider-a"]?.active).toBe(1);
+    expect(row(b.id)).toBeDefined();
+  });
+
+  test("HTTP/WS taps reject the other transport and repeated admission is idempotent", () => {
+    for (const transport of ["http", "ws"] as const) {
+      const { value, id } = start(undefined, transport);
+      begin(value, `${id}-duplicate`, epoch, undefined, transport);
+      delta(value, "abcd", "http"); delta(value, "abcd", "ws");
+      expect(row(id).outputTokens).toBe(1);
+      expect(row(`${id}-duplicate`)).toBeUndefined();
+    }
+    expect(snapshot().requests).toHaveLength(2);
+  });
+
+  test("duplicate request ids cannot let one context remove another's active row", () => {
+    const a = context(); const b = context();
+    begin(a, "duplicate-id", epoch);
+    begin(b, "duplicate-id", epoch);
+    finish(b, "failed");
+    // A collision may be rejected or tracked under a distinct id, but cannot orphan A.
+    expect(snapshot().requests.some(value => value.requestId === "duplicate-id")).toBe(true);
+    delta(a, "abcd");
+    expect(row("duplicate-id").outputTokens).toBe(1);
+  });
+
+  test("abort detaches listeners, freezes terminal output, and repeated finish is harmless", () => {
+    const controller = new AbortController();
+    const remove = spyOn(controller.signal, "removeEventListener");
+    try {
+      const { value, id } = start(undefined, "http", controller.signal);
+      now += 12; delta(value, "abcd"); now += 8;
+      controller.abort(); controller.abort(); finish(value, "failed");
+      delta(value, "must not count");
+      expect(row(id)).toBeUndefined();
+      expect(snapshot().finishedRequests).toHaveLength(1);
+      expect(snapshot().finishedRequests[0]).toMatchObject({ requestId: id,
+        terminalStatus: "aborted", durationMs: 20, firstOutputMs: 12, outputTokens: 1 });
+      now += 999;
+      expect(snapshot().finishedRequests[0]?.durationMs).toBe(20);
+      expect(remove).toHaveBeenCalledTimes(1);
+    } finally { remove.mockRestore(); }
+  });
+
+  for (const status of ["failed", "incomplete", "completed"]) {
+    test(`${status} cleans up exactly once, including a later abort`, () => {
+      const controller = new AbortController();
+      const remove = spyOn(controller.signal, "removeEventListener");
+      try {
+        const { value, id } = start(undefined, "http", controller.signal);
+        finish(value, status); finish(value, status); controller.abort();
+        observe(undefined, {}); finish(undefined);
+        expect(row(id)).toBeUndefined();
+        expect(snapshot().finishedRequests).toEqual([expect.objectContaining({ requestId: id, terminalStatus: status })]);
+        expect(remove).toHaveBeenCalledTimes(1);
+      } finally { remove.mockRestore(); }
+    });
+  }
+
+  test("already-aborted signals are never admitted", () => {
+    const controller = new AbortController(); controller.abort();
+    start(undefined, "http", controller.signal);
+    expect(snapshot().requests).toHaveLength(0);
+    expect(snapshot().finishedRequests).toHaveLength(0);
+  });
+
+  for (const estimated of [true, false]) {
+    test(`upstream usage estimated=${estimated} keeps provenance distinct`, () => {
+      const value = context({ usage: {
+        inputTokens: 10, outputTokens: 77, estimated,
+      } });
+      const { id } = start(value); delta(value, "abcd");
+      expect(row(id)).toMatchObject({ outputTokens: 1, usageStatus: "estimated", estimated: true });
