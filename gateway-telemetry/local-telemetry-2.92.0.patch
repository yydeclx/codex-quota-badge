+/** Optional local companion telemetry: bounded numeric state, no payload retention or timers. */
+import { estimateTokensFromCharacterCounts } from "../lib/token-estimate";
+import type { RequestLogContext } from "./request-log";
+
+const MAX_ACTIVE = 128;
+const MAX_FINISHED = 32;
+const FINISHED_TTL_MS = 10_000;
+const MAX_AGE_MS = 30 * 60_000;
+type Context = Pick<RequestLogContext, "provider" | "model" | "conversationId" | "usage" | "attempts" | "activeAttempt">;
+type Row = {
+  requestId: string; startedAt: number; mono: number; transport: "http" | "ws";
+  context: WeakRef<Context>; latin: number; cjk: number;
+  firstOutputMs?: number; genStartMs?: number; lastOutputMs?: number;
+  cleanup: () => void;
+};
+type Finished = { at: number; value: Record<string, unknown> };
+const active = new Map<string, Row>();
+const byContext = new WeakMap<Context, Row>();
+const finished: Finished[] = [];
+const enabled = process.env.OPENCODEX_COMPANION_TELEMETRY !== "0";
+const CONTENT_EVENTS = new Set(["response.output_text.delta", "response.reasoning_text.delta", "response.reasoning_summary_text.delta", "response.function_call_arguments.delta", "response.custom_tool_call_input.delta"]);
+const elapsed = (row: Row) => Math.max(0, performance.now() - row.mono);
+const label = (value: unknown) => typeof value === "string" && /^[\w./:+ -]{1,100}$/.test(value) ? value : undefined;
+
+function project(row: Row, terminalStatus?: string): Record<string, unknown> {
+  const context = row.context.deref();
+  const provider = label(context?.provider) ?? "unknown";
+  const model = label(context?.model);
+  const sends = (context?.attempts ?? []).reduce((n, a) => n + Math.max(0, a.sendCount || 0), 0);
+  const measured = terminalStatus && context?.usage?.estimated !== true ? context?.usage?.outputTokens : undefined;
+  const reported = typeof measured === "number" && Number.isFinite(measured) && measured >= 0;
+  return {
+    requestId: row.requestId, provider, model, conversationId: label(context?.conversationId),
+    startedAt: row.startedAt, durationMs: elapsed(row), firstOutputMs: row.firstOutputMs,
+    genStartMs: row.genStartMs, lastOutputMs: row.lastOutputMs,
+    lastOutputAt: row.lastOutputMs === undefined ? null : row.startedAt + row.lastOutputMs,
+    outputTokens: reported ? measured : estimateTokensFromCharacterCounts(row.latin, row.cjk, model),
+    usageStatus: reported ? "reported" : "estimated", usageSource: reported ? "upstream" : "characters",
+    estimated: !reported, retries: Math.max(0, sends - 1), ...(terminalStatus ? { terminalStatus } : {}),
+  };
+}
+
+/** Register after admission, before the first upstream wait. The context is only weakly retained. */
+export function beginProviderActivity(context: Context, requestId: string, startedAt: number, signal?: AbortSignal, transport: "http" | "ws" = "http"): void {
+  try {
+    if (!enabled || byContext.has(context) || active.has(requestId) || active.size >= MAX_ACTIVE || signal?.aborted) return;
+    if (!label(requestId) || !Number.isFinite(startedAt)) return;
+    const reference = new WeakRef(context);
+    const onAbort = () => finishProviderActivity(reference.deref(), "aborted");
+    const row: Row = { requestId, startedAt, mono: performance.now(), transport,
+      context: reference, latin: 0, cjk: 0,
+      cleanup: () => signal?.removeEventListener("abort", onAbort) };
+    active.set(requestId, row); byContext.set(context, row);
+    signal?.addEventListener("abort", onAbort, { once: true });
+  } catch { /* Optional metrics never interrupt inference. */ }
+}
+
+/** Called only at one actual client-delivery tap; preflight inspectors never call this. */
+export function observeProviderActivity(context: Context | undefined, payload: unknown, transport: "http" | "ws" = "http"): void {
+  try {
+    if (!enabled || !context) return;
+    const row = byContext.get(context);
+    if (!row || row.transport !== transport || !payload || typeof payload !== "object") return;
+    const event = payload as { type?: unknown; delta?: unknown };
+    if (event.type === "response.output_item.added") { row.genStartMs ??= elapsed(row); return; }
+    if (typeof event.type !== "string" || !CONTENT_EVENTS.has(event.type) || typeof event.delta !== "string" || !event.delta.length) return;
+    const now = elapsed(row);
+    row.firstOutputMs ??= now; row.genStartMs ??= now; row.lastOutputMs = now;
+    // Match the existing estimator's script buckets, incrementally. No full-output allocation.
+    let cjk = 0;
+    for (let i = 0; i < event.delta.length; i++) {
+      const c = event.delta.charCodeAt(i);
+      if ((c >= 0xac00 && c <= 0xd7a3) || (c >= 0x1100 && c <= 0x11ff)
+        || (c >= 0x3130 && c <= 0x318f) || (c >= 0x4e00 && c <= 0x9fff)
+        || (c >= 0x3400 && c <= 0x4dbf) || (c >= 0x3040 && c <= 0x30ff)) cjk++;
+    }
+    row.cjk += cjk; row.latin += event.delta.length - cjk;
+  } catch { /* Optional metrics never interrupt inference. */ }
+}
+
+export function finishProviderActivity(context: Context | undefined, terminalStatus = "completed"): void {
+  try {
+    if (!context) return;
+    const row = byContext.get(context);
+    if (!row) return;
+    active.delete(row.requestId); byContext.delete(context); row.cleanup();
+    finished.push({ at: performance.now(), value: project(row, terminalStatus) });
+    if (finished.length > MAX_FINISHED) finished.shift();
+  } catch { /* Cleanup is idempotent and cannot alter the final response. */ }
+}
+
+export function providerActivitySnapshot() {
+  const now = performance.now();
+  while (finished.length && now - finished[0]!.at > FINISHED_TTL_MS) finished.shift();
+  for (const [id, row] of active) {
+    if (elapsed(row) > MAX_AGE_MS || !row.context.deref()) {
+      active.delete(id); const context = row.context.deref(); if (context) byContext.delete(context); row.cleanup();
+    }
+  }
+  const requests = [...active.values()].map(row => project(row));
+  const providers: Record<string, { active: number; lastOutputAt: number | null }> = Object.create(null);
+  for (const request of requests) {
+    const key = request.provider as string;
+    const provider = providers[key] ??= { active: 0, lastOutputAt: null };
+    provider.active++;
+    if (typeof request.lastOutputAt === "number") provider.lastOutputAt = Math.max(provider.lastOutputAt ?? 0, request.lastOutputAt);
+  }
+  return { schemaVersion: 3, pid: process.pid, generatedAt: Date.now(), scope: "responses",
+    source: "provider-activity", supportsLive: enabled, providers, requests,
+    finishedRequests: finished.map(row => row.value), limits: { active: MAX_ACTIVE, finished: MAX_FINISHED } };
+}
