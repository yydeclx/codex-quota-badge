+describe("real SSE inspector delivery tap", () => {
+  test("arbitrarily split UTF-8/CRLF frames remain byte-exact and parse once per event", async () => {
+    const { value, id } = start();
+    const text = "abc中文🙂";
+    const wire = new TextEncoder().encode(": keepalive\r\n\r\nevent: response.output_text.delta\r\ndata: "
+      + JSON.stringify({ type: "response.output_text.delta", delta: text })
+      + "\r\n\r\ndata: " + JSON.stringify({ type: "response.completed", response: { status: "completed" } })
+      + "\n\ndata: [DONE]\n\n");
+    let parses = 0;
+    const parse = spyOn(JSON, "parse");
+    const originalParse = parse.getMockImplementation();
+    parse.mockImplementation((...args: Parameters<typeof JSON.parse>) => {
+      parses++; return originalParse!(...args);
+    });
+    const received: number[] = [];
+    const inspector = createSseInspector({
+      onParsedPayload: payload => observe(value, payload),
+      onTerminal: status => finish(value, status),
+    });
+    try {
+      const stream = new ReadableStream<Uint8Array>({ start(controller) {
+        for (const byte of wire) controller.enqueue(Uint8Array.of(byte));
+        controller.close();
+      } });
+      for await (const chunk of stream) {
+        inspector.feed(chunk);
+        received.push(...chunk);
+      }
+      inspector.finish();
+      expect(Uint8Array.from(received)).toEqual(wire);
+      expect(parses).toBe(2);
+      expect(row(id)).toBeUndefined();
+      expect(snapshot().finishedRequests[0]).toMatchObject({ requestId: id,
+        outputTokens: estimateTokens(text, "gpt-test"), terminalStatus: "completed" });
+    } finally { inspector.dispose(); parse.mockRestore(); }
+  });
